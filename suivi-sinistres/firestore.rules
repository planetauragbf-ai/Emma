rules_version = '2';
// Accès par rôle. Un utilisateur n'a AUCUN accès tant que l'administrateur n'a pas créé
// le document members/<son e-mail en minuscules> avec role = "admin" | "staff" | "cf".
//   admin : tout + gestion des membres
//   staff : équipe Planet Aura, lecture/écriture des dossiers
//   cf    : partenaire Coste Fermon, lecture seule de l'espace partagé (cf_share)
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(email()));
    }
    function role() { return get(/databases/$(database)/documents/members/$(email())).data.role; }
    function admin() { return isMember() && role() == 'admin'; }
    function staff() { return isMember() && role() in ['admin', 'staff']; }
    function cf()    { return isMember() && role() == 'cf'; }

    match /members/{mail} {
      allow read: if admin() || (isMember() && mail == email());
      allow create, update: if admin()
        && request.resource.data.role in ['admin', 'staff', 'cf']
        && request.resource.data.keys().hasOnly(['role', 'name', 'added']);
      allow delete: if admin() && mail != email();   // un admin ne peut pas se retirer lui-même
    }
    match /profiles/{uid} {
      allow read: if staff() || (isMember() && uid == request.auth.uid);
      allow write: if isMember() && uid == request.auth.uid;
    }
    // Espace partenaire
    match /cf_share/{id} {
      allow read: if staff() || cf();
      allow write: if staff();
    }
    match /config/cf {
      allow read: if staff() || cf();
    }
    // Toutes les données de l'application (dossiers, mails, pots, docs, compta, balancier, logs, team, config…)
    match /{col}/{id} {
      allow read, write: if staff() && !(col in ['members', 'profiles']);
    }
  }
}
